# Compose reads this file after: cp .env.example .env
# build.sh reads the shell environment, not .env. Export RUNTIME_BASE_IMAGE separately.
RUNTIME_BASE_IMAGE=hsbc-approved/python-runtime:local
MCP_IMAGE=github-mcp:local

# HTTPS enterprise WEB host, not /api/v3. Upstream derives the API URL.
GITHUB_HOST=https://github.internal.example
# Used only for live prestart stdio tests; removed before HTTP startup.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOOLSETS=repos,pull_requests
# Additional individual tools, comma separated; leave empty to use toolsets.
GITHUB_TOOLS=
GITHUB_READ_ONLY=true
GITHUB_LOCKDOWN_MODE=false

# Host-side published port and interface; internal port is always 8082.
MCP_HOST_PORT=8082
MCP_PUBLISH_HOST=127.0.0.1
# Internal container listener; do not use 127.0.0.1 with Docker port publishing.
MCP_BIND_HOST=0.0.0.0
# Externally advertised origin, including external port, for OAuth metadata.
MCP_BASE_URL=http://localhost:8082
# OAuth resource metadata path; does not rewrite upstream's /mcp HTTP route.
MCP_BASE_PATH=/mcp
MCP_SCOPE_CHALLENGE=false
GITHUB_AUTHORIZATION_SERVER=

# Existing host directories. Bind source auto-creation is disabled.
HOST_REPO_PATH=.
CONTAINER_REPO_PATH=/work/repo
HOST_TMP_DIR=./tmp
CONTAINER_TMP_DIR=/work/tmp
LOG_DIR=./logs
CONTAINER_LOG_DIR=/work/logs
# Leave empty for no extra CA; Compose mounts /dev/null in that case.
CUSTOM_CA_CERT_PATH=
# Existing CA trust store supplied by the approved runtime image.
CA_BUNDLE_PATH=/etc/ssl/certs/ca-certificates.crt

# live is the default and verifies GitHub API operations. offline blocks test sockets.
PRESTART_TEST_MODE=live
TEST_REPO_OWNER=
TEST_REPO_NAME=
TEST_REPO_BRANCH=main
TEST_REPO_FILE_PATH=README.md
# Select a real PR with a non-empty diff and accessible author in lockdown mode.
TEST_PR_NUMBER=
# Per RPC / executable command timeout; total test duration can be longer.
TEST_TIMEOUT_SECONDS=30
# Total attempts including the first, 1-10. No infinite retry or fallback to offline.
TEST_RETRIES=1

# Optional internal proxy. NO_PROXY must include the enterprise host when bypassing it.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
